# Copy this file to .env and paste your Claude API key after the "=".
# .env is git-ignored. Never commit it, never paste the key into a chat,
# and never export it in your shell (the app reads it from .env itself).
RTA_ANTHROPIC_API_KEY=

# Optional, defaults shown. The app reads these from your shell first, then from this file.
# RTA_MODEL=haiku              # haiku | sonnet | opus
# RTA_EFFORT=low               # low | medium | high | xhigh | max
# RTA_TODAY=2026-11-06         # the date the sample billing data is frozen at
# RTA_BUDGET_USD=40            # total budget per ledger file: runs/costs.csv for rta triage,
#                              # runs/<name>/costs.csv for a benchmark run (which also has its own --budget)
